      "kind": "button",
      "refersTo": "button-text",
      "description": "Read or close an inspector without competing with submission.",
      "html": "<button class=\"ds-text ds-focus\">Read now</button>",
      "css": ".ds-text{font-family:\"Public Sans Variable\",sans-serif;border:0;border-radius:5px;cursor:pointer;transition:background .15s ease;background:transparent;color:var(--blue,#1859c9);font-size:10px;display:flex;gap:5px;align-items:center;padding:4px 0;}.ds-text:hover{background:transparent;text-decoration:underline;}.ds-text:disabled{cursor:wait;opacity:.5}.ds-focus:focus-visible{outline:3px solid #3479df;outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-text{transition:none}}"
