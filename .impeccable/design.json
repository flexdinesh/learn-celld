      "description": "Informational count beside an evidence label.",
      "html": "<span class=\"ds-count\" aria-label=\"117 submissions\">117</span>",
      "css": ".ds-count{font-family:\"Public Sans Variable\",sans-serif;font-size:9px;background:#eaf0f7;padding:2px 5px;border-radius:4px;color:#526b89}"
    },
    {
      "name": "Apparatus Container",
      "kind": "card",
      "refersTo": "panel",
      "description": "A flat, ruled white panel for the topology, workbench or evidence.",
      "html": "<section class=\"ds-panel\"><h2>Live topology</h2><p>Three node bays share one bucket.</p></section>",
      "css": ".ds-panel{font-family:\"Public Sans Variable\",sans-serif;background:#fff;border:1px solid var(--line,#d8e0e8);border-radius:10px;overflow:hidden;color:#243446}.ds-panel h2{margin:0;padding:18px 20px 14px;font-size:13px;font-weight:650}.ds-panel p{margin:0;border-top:1px solid #ecf0f4;background:#f9fbfd;padding:12px 20px;font-size:10px}"
    },
    {
      "name": "Owned Node Bay",
      "kind": "custom",
      "refersTo": "node",
      "description": "An ownership-marked node with health and operational controls.",
      "html": "<section class=\"ds-node ds-owned\"><div class=\"ds-node-head\"><h3>node-a</h3><span class=\"ds-health\"><i></i>Ready</span></div><dl class=\"ds-stats\"><div><dt>Owned</dt><dd>1</dd></div><div><dt>Resident</dt><dd>1</dd></div><div><dt>Memory</dt><dd>39.0 MB</dd></div></dl><div class=\"ds-cell\"><i></i><strong>counter</strong><span>epoch 3</span></div><div class=\"ds-node-controls\"><button class=\"ds-focus\">Stop gracefully</button><button class=\"ds-danger ds-focus\">Crash</button><details><summary class=\"ds-focus\">State</summary><pre>{\"ready\":true}</pre></details></div></section>",
      "css": ".ds-node{font-family:\"Public Sans Variable\",sans-serif;border:1px solid #d4dee9;border-radius:7px;position:relative;min-width:0;background:#fff;color:#243446}.ds-node.ds-owned{border-color:var(--blue,#1859c9);background:#f6f9ff}.ds-node-head{display:flex;align-items:center;justify-content:space-between;padding:13px 13px 11px;gap:6px}.ds-node h3{margin:0;font-size:12px;font-family:var(--mono,ui-monospace,SFMono-Regular,Menlo,monospace);font-weight:600}.ds-health{display:flex;gap:5px;align-items:center;font-size:9px;color:var(--green,#176544)}.ds-health i{width:6px;height:6px;border-radius:50%;background:currentColor}.ds-stats{display:flex;gap:16px;margin:0;padding:0 13px 12px}.ds-stats dt{font-size:9px;color:var(--muted,#5b6c7f);margin-bottom:5px}.ds-stats dd{margin:0;font-size:13px;font-family:var(--mono,ui-monospace,SFMono-Regular,Menlo,monospace);font-weight:500}.ds-cell{border-top:1px solid #e4eaf2;border-bottom:1px solid #e4eaf2;min-height:37px;padding:10px 13px;font-size:9px;display:flex;gap:7px;align-items:center}.ds-cell i{background:var(--blue,#1859c9);width:6px;height:6px}.ds-cell strong{color:var(--blue,#1859c9)}.ds-cell span{margin-left:auto}.ds-node-controls{display:flex;padding:8px 10px;gap:7px;align-items:center;flex-wrap:wrap}.ds-node-controls button{font-family:\"Public Sans Variable\",sans-serif;border:0;border-radius:5px;cursor:pointer;transition:background .15s ease;padding:4px 3px;background:transparent;font-size:9px;color:var(--muted,#5b6c7f)}.ds-node-controls button:hover{background:#dce7f4}.ds-node-controls .ds-danger{color:var(--red,#a42f38)}.ds-node-controls details{margin-left:auto;font-size:9px;color:var(--muted,#5b6c7f)}.ds-node-controls summary{cursor:pointer}.ds-node-controls details[open]{width:100%;margin-left:0}.ds-node-controls pre{font-family:var(--mono,ui-monospace,SFMono-Regular,Menlo,monospace);white-space:pre-wrap}.ds-focus:focus-visible{outline:3px solid #3479df;outline-offset:3px}@media(max-width:650px){.ds-node-controls button,.ds-node-controls details{font-size:11px}.ds-node-controls button,.ds-node-controls summary{min-height:44px;padding:12px 8px}.ds-health,.ds-cell{font-size:10px}}@media(prefers-reduced-motion:reduce){.ds-node-controls button{transition:none}}"
    },
    {
      "name": "Shared Bucket Strip",
      "kind": "custom",
      "refersTo": "storage-strip",
      "description": "The shared storage identity and health beneath the connectivity bus.",
      "html": "<div class=\"ds-bucket\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><ellipse cx=\"12\" cy=\"5\" rx=\"9\" ry=\"3\"/><path d=\"M3 5v14a9 3 0 0 0 18 0V5\"/><path d=\"M3 12a9 3 0 0 0 18 0\"/></svg><div><strong>MinIO</strong><span>Shared bucket <code>celld-lab</code></span></div><span class=\"ds-purpose\">Ownership records \u00b7 node leases \u00b7 durable logs &amp; snapshots</span><span class=\"ds-bucket-health\">94 objects</span></div>",
      "css": ".ds-bucket{font-family:\"Public Sans Variable\",sans-serif;background:#edf2f8;border-radius:5px;padding:12px 15px;display:flex;align-items:center;gap:12px;color:#46617f}.ds-bucket>div strong{font-size:12px;font-weight:650;display:block;color:#294562}.ds-bucket>div span{display:block;font-size:9px;margin-top:4px}.ds-bucket code{font-family:var(--mono,ui-monospace,SFMono-Regular,Menlo,monospace);font-size:.91em}.ds-purpose{font-size:9px;margin-left:18px}.ds-bucket-health{margin-left:auto;font-size:9px;color:var(--green,#176544)}@media(max-width:650px){.ds-bucket{padding:12px;gap:10px;flex-wrap:wrap}.ds-purpose{order:4;margin-left:0;font-size:9px;line-height:1.6;width:100%}}"
    },
    {
      "name": "Evidence Tabs",
      "kind": "nav",
      "description": "Switch between request and bucket evidence with an underlined selected state.",
      "html": "<div class=\"ds-tabs\" role=\"tablist\" aria-label=\"Evidence type\"><button class=\"ds-focus\" role=\"tab\" aria-selected=\"true\">Request timeline <span>117</span></button><button class=\"ds-focus\" role=\"tab\" aria-selected=\"false\">Bucket explorer <span>94</span></button></div>",
      "css": ".ds-tabs{display:flex;gap:21px}.ds-tabs button{font-family:\"Public Sans Variable\",sans-serif;border:0;border-radius:5px;cursor:pointer;transition:background .15s ease;background:transparent;border-radius:0;padding:16px 0 13px;border-bottom:2px solid transparent;color:var(--muted,#5b6c7f);font-size:11px;font-weight:550;display:flex;align-items:center;gap:7px}.ds-tabs button:hover{background:#e0e9f3}.ds-tabs button[aria-selected=\"true\"]{color:var(--blue,#1859c9);border-bottom-color:var(--blue,#1859c9)}.ds-tabs button>span{font-size:9px;background:#eaf0f7;padding:2px 5px;border-radius:4px;color:#526b89}.ds-focus:focus-visible{outline:3px solid #3479df;outline-offset:3px}@media(max-width:650px){.ds-tabs{gap:18px}}@media(prefers-reduced-motion:reduce){.ds-tabs button{transition:none}}"
    }
  ],
  "narrative": {
    "northStar": "The Network Switchboard",
    "overview": "A cool, ruled work surface presents an apparatus that can be operated and inspected. Graphite text, cobalt selections and restrained status colors keep attention on relationships and measured outcomes. This name and atmosphere describe the implemented direction; they were inferred from the brief, not separately confirmed as a brand preference.\n\nDensity comes from aligned compartments, short instructions and compact tables. The visual system supports the product commitment to real, observable mechanisms. Page composition and experiment sequencing remain in the surface contract.",
    "keyCharacteristics": [
      "Cool surfaces with thin structural rules.",
      "Cobalt actions and explicit ownership states.",
      "Public Sans controls with monospace evidence.",
      "Flat compartments and orthogonal connectivity.",
      "Responsive apparatus with persistent shared connections."
    ],
    "rules": [
      {
        "name": "The State Has a Name Rule",
        "body": "Pair status color with text or a distinct marker; health, ownership and ingress carry different meanings.",
        "section": "colors"
      },
      {
        "name": "The Evidence Voice Rule",
        "body": "Use monospace for measured values and technical identifiers; keep instructions and action names in Public Sans.",
        "section": "typography"
      },
      {
        "name": "The Shared Connection Rule",
        "body": "Reflow the apparatus without losing the common connection between node bays and storage.",
        "section": "layout"
      },
      {
        "name": "The Flat Apparatus Rule",
        "body": "Separate surfaces with tone and rules; reserve outlines and washes for meaningful states.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use color with named states and observable evidence.",
      "Do preserve shared connectivity when topology reflows.",
      "Do keep technical values in monospace and explanations in Public Sans.",
      "Do use tonal compartments and thin rules for depth.",
      "Do retain visible keyboard focus and reduced-motion behavior."
    ],
    "donts": [
      "Don't represent configured links as measured replication traffic.",
      "Don't conflate request ingress with observed ownership.",
      "Don't replace responsive table scrolling with clipped evidence.",
      "Don't propagate the current tiny metadata sizes into future body text."
    ]
  }
}
