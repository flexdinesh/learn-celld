    {
      "name": "Primary Request",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The main request submission action.",
      "html": "<button class=\"ds-primary ds-focus\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m22 2-7 20-4-9-9-4Z\"/><path d=\"M22 2 11 13\"/></svg>Send request</button>",
      "css": ".ds-primary{font-family:\"Public Sans Variable\",sans-serif;border:0;border-radius:5px;cursor:pointer;transition:background .15s ease;background:var(--blue,#1859c9);color:#fff;display:flex;gap:7px;align-items:center;padding:11px 13px;font-size:10px;font-weight:600;white-space:nowrap;}.ds-primary:hover{background:#114799;}.ds-primary:disabled{cursor:wait;opacity:.5}.ds-focus:focus-visible{outline:3px solid #3479df;outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}"
    },
    {
      "name": "Guided Experiment",
      "kind": "button",
      "refersTo": "button-guided",
      "description": "A subordinate action attached to experiment instructions.",
      "html": "<button class=\"ds-guided ds-focus\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m6 3 14 9-14 9V3z\"/></svg>Send first request</button>",
      "css": ".ds-guided{font-family:\"Public Sans Variable\",sans-serif;border:0;border-radius:5px;cursor:pointer;transition:background .15s ease;background:#e6eefb;color:#164e9e;font-size:11px;padding:10px 13px;display:flex;gap:7px;align-items:center;font-weight:600;}.ds-guided:hover{background:#d3e2fa;}.ds-guided:disabled{cursor:wait;opacity:.5}.ds-focus:focus-visible{outline:3px solid #3479df;outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-guided{transition:none}}"
    },
