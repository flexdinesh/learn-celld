      "html": "<label class=\"ds-label\">Cell name<input class=\"ds-field ds-focus\" value=\"counter\" maxlength=\"64\" /></label>",
      "css": ".ds-label{font-family:\"Public Sans Variable\",sans-serif;display:flex;flex-direction:column;gap:7px;font-size:10px;font-weight:550;color:#53677e}.ds-field{font-family:\"Public Sans Variable\",sans-serif;border:1px solid #ccd7e3;background:#fff;color:#2c425c;border-radius:5px;padding:10px;min-width:0;width:100%;font-size:11px;height:37px;caret-color:var(--blue,#1859c9)}.ds-field:hover{border-color:#7b9ec9}.ds-field:disabled{background:#edf1f5}.ds-focus:focus-visible{outline:3px solid #3479df;outline-offset:3px}@media(max-width:650px){.ds-field{font-size:12px}}"
